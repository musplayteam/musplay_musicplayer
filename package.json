{
  "name": "musplay",
  "private": true,
  "version": "1.0.0",
  "description": "MusPlay — локальный музыкальный плеер",
  "main": "electron.js",
  "author": "Сергей Швецов",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development npx electron .",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "lucide-react": "^0.468.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.musplay.app",
    "productName": "MusPlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload.js",
      "electron.js",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
